                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e20" edge="1" parent="1" source="lista" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=default;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;" target="nodo" value="head / tail (1 -- 0..*)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="leyenda" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;◆ Composicion&lt;/b&gt;: el dueño crea y controla la vida del objeto.&lt;/div&gt;&lt;div&gt;   Despensa crea su Lista&amp;lt;Producto&amp;gt;; Lista crea sus Nodo.&lt;/div&gt;&lt;div&gt;&lt;b&gt;◇ Agregacion&lt;/b&gt;: la Despensa guarda Productos que se crean&lt;/div&gt;&lt;div&gt;   afuera (Main o GestorArchivos) y se agregan con agregar(p).&lt;/div&gt;&lt;div&gt;&lt;b&gt;→ Asociacion&lt;/b&gt;: solo referencia objetos que ya existen.&lt;/div&gt;&lt;div&gt;   HiloCaducidad vigila la misma Despensa que usa Main.&lt;/div&gt;&lt;div&gt;&lt;b&gt;⇢ Dependencia&lt;/b&gt;: lo usa como parametro o metodo static&lt;/div&gt;&lt;div&gt;   (GestorArchivos, Consola, generar(despensa)).&lt;/div&gt;&lt;div&gt;&lt;b&gt;▷ Herencia&lt;/b&gt;: Perecedero, NoPerecedero y Limpieza extienden Producto.&lt;/div&gt;&lt;div&gt;&lt;b&gt;⇢▷ Realizacion&lt;/b&gt;: implementa una interfaz (IGuardable, Runnable).&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Visibilidad: + publico, - privado, # protegido, ~ paquete.&lt;/div&gt;&lt;div&gt;Lista&amp;lt;V&amp;gt; se usa tambien en ListaSuper y HiloCaducidad (avisos).&lt;/div&gt;" vertex="1">
                    <mxGeometry height="300" width="470" x="25" y="1980" as="geometry"/>
                </mxCell>
                <mxCell id="poli" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Polimorfismo (dynamic dispatch)&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;for (var n = productos.begin(); n != null; n = n.sig)&lt;/div&gt;&lt;div&gt;   if (n.valor.necesitaReponer()) r.append(n.valor);&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Leche (Perecedero) vencida → true aunque queden 2&lt;/div&gt;&lt;div&gt;Arroz (NoPerecedero) con 3 kg → false&lt;/div&gt;&lt;div&gt;Cloro (Limpieza) en 1 con minimo 1 → true (1 &amp;lt;= 1.5)&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Lo mismo con estaVencido() y toLinea(): GestorArchivos&lt;/div&gt;&lt;div&gt;guarda cada producto sin saber de que tipo es.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="240" width="440" x="25" y="1730" as="geometry"/>
                </mxCell>
                <mxCell id="hilos" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Concurrencia&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Hilo 1 (main): menu → agregar / consumir / eliminar&lt;/div&gt;&lt;div&gt;Hilo 2 (HiloCaducidad): cada 10 s → revisar()&lt;/div&gt;&lt;div&gt;   → despensa.vencidos() y porVencer(3)&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Los dos comparten la misma Despensa. Sus metodos son&lt;/div&gt;&lt;div&gt;&lt;b&gt;synchronized&lt;/b&gt;: si un hilo esta dentro, el otro espera.&lt;/div&gt;&lt;div&gt;Main muestra los avisos antes del menu para no&lt;/div&gt;&lt;div&gt;ensuciar lo que el usuario esta escribiendo.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="220" width="420" x="25" y="1490" as="geometry"/>
                </mxCell>
                <mxCell id="archivo" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;data/despensa.txt&lt;/b&gt;&lt;div&gt;TIPO;nombre;cantidad;minima;UNIDAD;[extra]&lt;/div&gt;&lt;div&gt;PERECEDERO;Leche;2;1;LITRO;2026-11-27&lt;/div&gt;&lt;div&gt;NOPERECEDERO;Arroz;2;1;KG&lt;/div&gt;&lt;div&gt;LIMPIEZA;Cloro;1;1;LITRO;true&lt;/div&gt;" vertex="1">
                    <mxGeometry height="130" width="360" x="25" y="1350" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
