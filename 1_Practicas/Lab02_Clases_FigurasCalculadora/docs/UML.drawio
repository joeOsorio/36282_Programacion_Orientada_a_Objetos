<mxCell id="leg" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;◆—— Composición: Calculadora crea y es dueña de una instancia de cada figura (atributos static).&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;~ = visibilidad de paquete (constructores sin modificador).&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Calculadora no se instancia: todo es static y ahí vive el main().&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="960" y="40" width="400" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>