{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Java (output)",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "${fileDirname}/../output",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
